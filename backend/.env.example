NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
FRONTEND_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talent_forge?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
LMS_APP_URL=http://localhost:3000
LMS_LAUNCH_SECRET=change-this-access-secret

LOCAL_UPLOAD_DIR=uploads
REGISTRATION_STORAGE_DRIVER=local
# Set REGISTRATION_STORAGE_DRIVER=azure and provide these when you want Azure-backed registration files.
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER_NAME=uploads
