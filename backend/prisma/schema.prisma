generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  registered
  game_pending
  game_completed
  review
  verification_pending
  verified
  onboarding
  accepted
  rejected
}

enum CohortStatus {
  open
  in_review
  closed
}

enum SelectionGameStatus {
  upcoming
  active
  completed
}

enum RegistrationDocumentType {
  school_id_card
  nin_scan
  profile_picture
  government_id
  other
}

enum RegistrationDocumentStatus {
  pending_review
  approved
  rejected
  needs_reupload
}

enum ProgressionDashboardState {
  status_only
  countdown
  game_access
  onboarding_form
  full_learning
}

enum OnboardingDocumentType {
  cys_form
  logbook
  acceptance_letter
  other
}

enum OnboardingDocumentStatus {
  pending_review
  approved
  rejected
  needs_reupload
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  campuses Campus[]
  users    User[]
}

model Campus {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  locationCity    String
  locationState   String
  locationAddress String
  capacity        Int
  createdAt       DateTime @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id])
  studentProfiles StudentProfile[]
  applications    Application[]
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  firstName      String
  lastName       String
  email          String   @unique
  phone          String
  passwordHash   String
  nin            String   @unique
  avatarUrl      String?
  createdAt      DateTime @default(now())
  isActive       Boolean  @default(true)

  organization         Organization           @relation(fields: [organizationId], references: [id])
  studentProfile       StudentProfile?
  applications         Application[]
  refreshTokens        RefreshToken[]
  userRoles            UserRole[]
  gameAttempts         GameAttempt[]
  SelectionGameAttempt SelectionGameAttempt[]
  questProgress        QuestProgress[]
  exerciseProgress     ExerciseProgress[]
  giteaAccount         GiteaAccount?
  giteaRepositories    GiteaRepository[]
  submissions          Submission[]
  auditQueue           AuditQueue[]
  auditPoint           AuditPoint?
  auditBlocksCreated   AuditBlock[]             @relation("AuditBlockUser")
  auditBlocksReceived  AuditBlock[]             @relation("AuditBlockBlockedUser")
  auditsAsAuditee      Audit[]                  @relation("AuditAuditee")
  auditsAsAuditor      Audit[]                  @relation("AuditAuditor")
  xpTransactions       XPTransaction[]
}

model StudentProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  institutionName  String
  institutionEmail String?
  matricNumber     String   @unique
  department       String
  level            String
  campusId         String
  createdAt        DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  campus Campus @relation(fields: [campusId], references: [id])
}

model ApplicationCohort {
  id              String       @id @default(uuid())
  name            String
  status          CohortStatus @default(open)
  opensAt         DateTime
  closesAt        DateTime
  gameCutoffScore Int
  maxApplicants   Int?
  createdAt       DateTime     @default(now())

  applications  Application[]
  selectionGame SelectionGame?
}

model Application {
  id             String                    @id @default(uuid())
  userId         String
  cohortId       String
  campusId       String
  status         ApplicationStatus         @default(registered)
  dashboardState ProgressionDashboardState @default(status_only)
  registeredAt   DateTime                  @default(now())
  gameScore      Int?
  passedGame     Boolean?
  metadata       Json?

  user                  User                   @relation(fields: [userId], references: [id])
  cohort                ApplicationCohort      @relation(fields: [cohortId], references: [id])
  campus                Campus                 @relation(fields: [campusId], references: [id])
  registrationDocuments RegistrationDocument[]
  gameAttempts          GameAttempt[]
  onboardingDocuments   OnboardingDocument[]
  SelectionGameAttempt  SelectionGameAttempt[]

  @@index([userId, registeredAt])
}

model SelectionGame {
  id              String              @id @default(uuid())
  cohortId        String              @unique
  name            String
  description     String?
  scheduledAt     DateTime
  durationMinutes Int
  accessMethod    String?
  configuration   Json?
  status          SelectionGameStatus @default(upcoming)

  cohort               ApplicationCohort      @relation(fields: [cohortId], references: [id])
  attempts             GameAttempt[]
  SelectionGameAttempt SelectionGameAttempt[]
}

model GameAttempt {
  id                 String    @id @default(uuid())
  gameId             String
  userId             String
  applicationId      String
  startedAt          DateTime  @default(now())
  deadlineAt         DateTime
  completedAt        DateTime?
  score              Int?
  passed             Boolean?
  breakdown          Json?
  attemptData        Json?
  timeElapsedSeconds Int?

  game        SelectionGame @relation(fields: [gameId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
  application Application   @relation(fields: [applicationId], references: [id])

  @@index([userId, startedAt])
  @@index([applicationId, startedAt])
}

model OnboardingDocument {
  id               String                   @id @default(uuid())
  applicationId    String
  documentType     OnboardingDocumentType
  fileUrl          String
  originalFilename String
  status           OnboardingDocumentStatus @default(pending_review)
  metadata         Json?
  uploadedAt       DateTime                 @default(now())

  application Application @relation(fields: [applicationId], references: [id])

  @@index([applicationId, documentType])
}

model SelectionGameAttempt {
  id              String    @id @default(uuid())
  selectionGameId String
  userId          String
  applicationId   String
  startedAt       DateTime  @default(now())
  deadlineAt      DateTime?
  score           Int?
  passed          Boolean?
  completedAt     DateTime?
  attemptData     Json?

  selectionGame SelectionGame @relation(fields: [selectionGameId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  application   Application   @relation(fields: [applicationId], references: [id])

  @@index([userId, selectionGameId])
}

model RegistrationDocument {
  id               String                     @id @default(uuid())
  applicationId    String
  documentType     RegistrationDocumentType
  fileUrl          String
  originalFilename String
  status           RegistrationDocumentStatus @default(pending_review)
  uploadedAt       DateTime                   @default(now())

  application Application @relation(fields: [applicationId], references: [id])
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  userRoles UserRole[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
}

model Quest {
  id          String   @id
  name        String
  slug        String   @unique
  description String?
  language    String   @default("python")
  xpReward    Int      @default(0)
  level       Int?
  manifest    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  exercises    QuestExercise[]
  progress     QuestProgress[]
  submissions  Submission[]
  audits       Audit[]
  repositories GiteaRepository[]
  xpTransactions XPTransaction[]
}

model QuestExercise {
  id                    String   @id @default(uuid())
  questId               String
  exerciseId            String
  name                  String
  path                  String
  order                 Int      @default(0)
  level                 Int?
  xpReward              Int      @default(0)
  instructions          String?
  filesToSubmit         Json?
  allowedFunctions      Json?
  defaultCode           String?
  defaultCodeByLanguage Json?
  sampleTests           Json?
  hiddenTests           Json?
  restrictions          Json?
  auditChecklist        Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt

  quest Quest @relation(fields: [questId], references: [id])

  @@unique([questId, exerciseId])
  @@index([questId, order])
}

model QuestProgress {
  id                String    @id @default(uuid())
  userId            String
  questId           String
  status            String    @default("IN_PROGRESS")
  currentExerciseId String?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  updatedAt         DateTime  @default(now()) @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  quest Quest @relation(fields: [questId], references: [id])

  @@unique([userId, questId])
  @@index([questId, status])
}

model ExerciseProgress {
  id         String   @id @default(uuid())
  userId     String
  questId    String
  exerciseId String
  status     String   @default("PASSED")
  results    Json?
  passedAt   DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, questId, exerciseId])
  @@index([questId, exerciseId, status])
}

model GiteaAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  giteaUserId   Int?
  giteaUsername String   @unique
  email         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model GiteaRepository {
  id          String   @id @default(uuid())
  userId      String?
  questId     String?
  repoFullName String  @unique
  owner       String
  name        String
  repoUrl     String
  giteaRepoId Int?
  isTemplate  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  user  User?  @relation(fields: [userId], references: [id])
  quest Quest? @relation(fields: [questId], references: [id])
  submissions Submission[]

  @@unique([userId, questId])
  @@index([questId])
}

model Submission {
  id           String   @id @default(uuid())
  userId       String
  questId      String
  exerciseId   String?
  repositoryId String?
  commitHash   String?
  status       String   @default("submitted")
  result       Json?
  submittedAt  DateTime @default(now())
  auditedAt    DateTime?

  user       User             @relation(fields: [userId], references: [id])
  quest      Quest            @relation(fields: [questId], references: [id])
  repository GiteaRepository? @relation(fields: [repositoryId], references: [id])
  audits     Audit[]

  @@index([userId, submittedAt])
  @@index([questId, exerciseId, status])
}

model Audit {
  id               String    @id @default(uuid())
  auditeeId        String
  auditorId        String
  questId          String
  exerciseId       String
  submissionId     String?
  status           String    @default("AUDITING")
  checklistResults Json?
  feedback         String?
  repoUrl          String?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  finishedAt       DateTime?

  auditee    User        @relation("AuditAuditee", fields: [auditeeId], references: [id])
  auditor    User        @relation("AuditAuditor", fields: [auditorId], references: [id])
  quest      Quest       @relation(fields: [questId], references: [id])
  submission Submission? @relation(fields: [submissionId], references: [id])

  @@index([auditeeId, status])
  @@index([auditorId, status])
  @@index([questId, exerciseId, status])
}

model AuditQueue {
  id         String   @id @default(uuid())
  userId     String
  questId    String
  exerciseId String
  status     String   @default("WAITING")
  joinedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, questId, exerciseId])
  @@index([questId, exerciseId, status])
}

model AuditPoint {
  userId          String   @id
  points          Int      @default(1)
  auditsCompleted Int     @default(0)
  updatedAt       DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model AuditBlock {
  id            String   @id @default(uuid())
  userId        String
  blockedUserId String
  reason        String   @default("recent_audit")
  createdAt     DateTime @default(now())

  user        User @relation("AuditBlockUser", fields: [userId], references: [id])
  blockedUser User @relation("AuditBlockBlockedUser", fields: [blockedUserId], references: [id])

  @@unique([userId, blockedUserId, reason])
  @@index([userId, blockedUserId])
}

model XPTransaction {
  id          String   @id @default(uuid())
  userId      String
  questId     String?
  amount      Int
  sourceType  String
  sourceId    String
  description String
  createdAt   DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  quest Quest? @relation(fields: [questId], references: [id])

  @@unique([userId, sourceType, sourceId])
  @@index([userId, createdAt])
}
